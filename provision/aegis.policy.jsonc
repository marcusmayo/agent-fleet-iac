{
  // Fleet governance policy — structural caps enforced BEFORE any provisioning,
  // fail-closed. Non-secret, so it is committed and version-controlled: the policy
  // itself is the reviewable governance artifact. `fleetctl up --go` enforces this
  // today; the Aegis panel will enforce the same file once panel-driven provisioning
  // lands. Edit the numbers here to change the caps.

  "maxFleet": 6,                   // hard ceiling on total registered agents
  "maxBatch": 2,                   // most agents a single provisioning request may create
  "allowedRegions": ["eastus2"],   // agents may ONLY be stood up in these Azure regions
  "defaultRegion": "eastus2",      // region offered by the panel when a request omits one

  // Declared monthly budget (USD). NOT enforced by a static projected-cost gate:
  // the fleet deallocates between sessions, so real cost is runtime-driven and a
  // per-agent estimate would be misleading. This budget is enforced against ACTUAL
  // spend via Azure Cost Management (next step). Until then, maxFleet is the
  // structural bound on how many agents (and therefore how much) can exist.
  "maxMonthlyBudgetUsd": 150
}
